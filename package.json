{
  "name": "phasor-calculator",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "start": "node scripts/preview.mjs",
    "dev": "node scripts/build.mjs && node scripts/preview.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser.mjs && node tests/library-browser.mjs",
    "publish:prepare": "node scripts/build.mjs && node scripts/prepare-pages.mjs"
  },
  "dependencies": {
    "es-module-lexer": "1.7.0",
    "jsqr": "1.4.0",
    "mathjs": "14.8.1",
    "qrcode": "1.5.4",
    "trystero": "0.25.4"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "esbuild": "0.25.11"
  }
}
